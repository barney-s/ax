# params.env
# Deployment instance parameters for 'ax-gcp1'
# This file is sourced by deploy.sh and teardown.sh.

# Google Cloud Platform Context
export PROJECT="barni-cnrm-20260529"
export CLUSTER="ax1"
export REGION="${CLOUDSDK_COMPUTE_REGION:-us-central1}"

# Container Registry Configuration
export AX_IMAGE_REPO="gcr.io/${PROJECT}/ate-images"
export TASK_RUNNER_REPO="${AX_IMAGE_REPO}/ax-task-runner"

# Environment context variables expected by Makefile / tools
export KO_DOCKER_REPO="${AX_IMAGE_REPO}"
