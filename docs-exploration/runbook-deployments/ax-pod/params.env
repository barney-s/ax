# params.env
# Deployment instance parameters for 'ax-pod'
# This file is sourced by deploy.sh and teardown.sh.

# Environment Context
# Defaults from the environment where the guidance doesn't pin them
export PROJECT="${GOOGLE_CLOUD_PROJECT:-}"
export REGION="${CLOUDSDK_COMPUTE_REGION:-}"

# Application Port
export AX_PORT="8080"

# Address where AX Server binds to
export AX_SERVER_ADDR=":${AX_PORT}"

# Redis Address for the AX Server to connect to
export AX_REDIS_ADDR="localhost:6379"

# Redis deployment configuration
# Set to "true" to run Redis using Docker, or "false" to run locally via redis-server
export USE_DOCKER_REDIS="false"

# Docker container name for Redis (only used if USE_DOCKER_REDIS is true)
export REDIS_CONTAINER_NAME="ax-redis"

# AX Server Address for verification
export AX_SERVER="http://localhost:${AX_PORT}"
