# params.env
# Deployment instance parameters for 'ak-ate-1'
# This file is sourced by deploy.sh and teardown.sh.

# Google Cloud Platform Context
export PROJECT_ID="barni-cnrm-20260529" # (pinned)
export CLUSTER_NAME="ak-ate-1"         # (pinned)

# Region and Zone defaults from environment or fallback
export REGION="${CLOUDSDK_COMPUTE_REGION:-us-central1}"
export ZONE="${CLOUDSDK_COMPUTE_ZONE:-us-central1-a}"

# Storage & Registry parameters
export BUCKET_NAME="ate-snapshots-${PROJECT_ID}"
export AX_IMAGE_REPO="gcr.io/${PROJECT_ID}/ate-images"
export TASK_RUNNER_REPO="${AX_IMAGE_REPO}/ax-task-runner"
export KO_DOCKER_REPO="${AX_IMAGE_REPO}"

# Additional compatibility parameters (used by Makefile or other scripts)
export PROJECT="${PROJECT_ID}"
export CLUSTER="${CLUSTER_NAME}"
