# params.env
# Deployment instance parameters for 'ak-ate-1'
# Sourced by deploy.sh and teardown.sh

# Google Cloud Platform Context
export PROJECT_ID="barni-cnrm-20260529"
export CLUSTER_NAME="ics-1"
export REGION="us-central1"
export ZONE="us-central1-a"
export CLUSTER_LOCATION="${ZONE}"
export GCE_REGION="${REGION}"
export BUCKET_NAME="ate-snapshots-${PROJECT_ID}-us-central1"

# Container Registry Configuration
export AX_IMAGE_REPO="gcr.io/${PROJECT_ID}/ate-images"
export TASK_RUNNER_REPO="${AX_IMAGE_REPO}/ax-task-runner"

# Environment context variables expected by Makefile / tools / Substrate
export KO_DOCKER_REPO="${AX_IMAGE_REPO}"

# Compatibility mapping for tools or scripts referencing PROJECT or CLUSTER directly
export PROJECT="${PROJECT_ID}"
export CLUSTER="${CLUSTER_NAME}"
